{
    "args": {
        "common": {
            "TARGET_ARCH": "aarch64a",
            "VARIANT": "aarch64a_pacret",
            "COMPILE_FLAGS": "-mcpu=cortex-a53 -march=armv8.3a -mbranch-protection=pac-ret+leaf",
            "LIBRARY_BUILD_TYPE": "release"
        },
        "musl-embedded": {
            "ENABLE_CXX_LIBS": "ON",
            "EXTRA_MUSL-EMBEDDED_CFLAGS": "-mstrict-align -fPIC -fno-rounding-math",
            "EXTRA_MUSL-EMBEDDED_CONFIG_FLAGS": "--quic-aarch64-optmem"
        }
    }
}
